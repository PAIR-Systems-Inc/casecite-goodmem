# Generate each value independently: openssl rand -hex 32
DB_ADMIN_PASSWORD=
CASECITE_DB_PASSWORD=
GOODMEM_DB_PASSWORD=
SECRET_KEY=
REGISTRATION_BOOTSTRAP_TOKEN=

# Local evaluation. Production: DEBUG=false and PUBLIC_URL=https://your-host.
DEBUG=true
PUBLIC_URL=http://localhost:8000
BIND_ADDRESS=127.0.0.1
PORT=8000
MAX_UPLOAD_MB=50

# Generation: OpenAI-compatible, native Claude or native Gemini. Personal keys
# can also be saved in the UI; local endpoints need no key unless configured.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
VOYAGE_API_KEY=
COHERE_API_KEY=
# Optional outbound AI policy. Empty list blocks all when enabled.
# Use self_hosted for local addresses, or a provider name / gateway hostname.
# Also configure the providers inside GoodMem to meet the same policy.
HIPAA_ENFORCEMENT_ENABLED=false
APPROVED_AI_PROVIDERS=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.5
OPENAI_UTILITY_MODEL=gpt-5.4-mini
LLM_CONTEXT_WINDOW=
JOB_TIMEOUT_SECONDS=3600
REVIEW_TABLE_CONCURRENCY=4
COURTLISTENER_API_TOKEN=
COURTLISTENER_BASE_URL=https://www.courtlistener.com/api/rest/v4
WORKFLOW_MAX_STEPS=12
WORKFLOW_MAX_DOCUMENTS_PER_STEP=25
WORKFLOW_MAX_CITATIONS_PER_STEP=10
WORKFLOW_MAX_OUTPUT_BYTES=524288
WORKFLOW_NOTIFICATIONS=false
DEEP_RESEARCH_MAX_SUBQUESTIONS=8
DEEP_RESEARCH_MAX_TOOL_CALLS=24
DEEP_RESEARCH_MAX_PASSAGES=60
DEEP_RESEARCH_CONCURRENCY=3
DEEP_RESEARCH_FOLLOWUP_DEPTH=1
# Full-opinion chat/strategy review: 80,000 characters per window, 2,000 overlap.
RESEARCH_MAX_WINDOWS_PER_OPINION=6

# Identity and email (also supported by the standalone binary).
REQUIRE_MFA=false
AUDIT_FAIL_CLOSED=false
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=
AZURE_SSO_AUTO_PROVISION=true
AZURE_SSO_DEFAULT_ROLE=viewer
# Only needed for a separately hosted Word pane; bundled /word-addin needs none.
ADDIN_ALLOWED_ORIGINS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=false

# Optional: reuse an embedder instead of creating one with setup-goodmem.
GOODMEM_EMBEDDER_ID=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
GOODMEM_RERANKER_ID=
# GoodMem's on-premise dots.ocr endpoint, reachable from the GoodMem container.
# The default points to a model on the Docker host; no hosted OCR fallback is used.
GOODMEM_OCR_BASE_URL=http://host.docker.internal:8001/v1
# Tested GoodMem server v1.0.334
GOODMEM_IMAGE=ghcr.io/pair-systems-inc/goodmem/server@sha256:162b02ebefae8c84db2e00856ead6c7d6e465d5afb8e6d68d5cc8e063b61a53b

# For a standalone binary using an EXISTING GoodMem installation:
# DATABASE_URL=postgres://casecite:password@localhost:5432/casecite?sslmode=require
# GOODMEM_BASE_URL=http://localhost:8080
# GOODMEM_API_KEY=your-server-side-key
# GOODMEM_SPACE_ID=your-space-uuid
# Alternatively: GOODMEM_CONFIG_FILE=/path/to/goodmem.json
