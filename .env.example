# Generate each value independently: openssl rand -hex 32
DB_ADMIN_PASSWORD=
CASECITE_DB_PASSWORD=
GOODMEM_DB_PASSWORD=
SECRET_KEY=
REGISTRATION_BOOTSTRAP_TOKEN=

# Local evaluation. Production: DEBUG=false and PUBLIC_URL=https://your-host.
DEBUG=true
PUBLIC_URL=http://localhost:8000
BIND_ADDRESS=127.0.0.1
PORT=8000
MAX_UPLOAD_MB=50

# Generation: OpenAI-compatible, native Claude or native Gemini. Personal keys
# can also be saved in the UI; local endpoints need no key unless configured.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
VOYAGE_API_KEY=
COHERE_API_KEY=
# Optional outbound AI policy. Empty list blocks all when enabled.
# Use self_hosted for local addresses, or a provider name / gateway hostname.
# Also configure the providers inside GoodMem to meet the same policy.
HIPAA_ENFORCEMENT_ENABLED=false
APPROVED_AI_PROVIDERS=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.5
OPENAI_UTILITY_MODEL=gpt-5.4-mini
LLM_CONTEXT_WINDOW=
JOB_TIMEOUT_SECONDS=3600
REVIEW_TABLE_CONCURRENCY=4
COURTLISTENER_API_TOKEN=
COURTLISTENER_BASE_URL=https://www.courtlistener.com/api/rest/v4
WORKFLOW_MAX_STEPS=12
WORKFLOW_MAX_DOCUMENTS_PER_STEP=25
WORKFLOW_MAX_CITATIONS_PER_STEP=10
WORKFLOW_MAX_OUTPUT_BYTES=524288
WORKFLOW_NOTIFICATIONS=false
DEEP_RESEARCH_MAX_SUBQUESTIONS=8
DEEP_RESEARCH_MAX_TOOL_CALLS=24
DEEP_RESEARCH_MAX_PASSAGES=60
DEEP_RESEARCH_CONCURRENCY=3
DEEP_RESEARCH_FOLLOWUP_DEPTH=1
# Full-opinion chat/strategy review: 80,000 characters per window, 2,000 overlap.
RESEARCH_MAX_WINDOWS_PER_OPINION=6

# Identity and email (also supported by the standalone binary).
REQUIRE_MFA=false
AUDIT_FAIL_CLOSED=false
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=
AZURE_SSO_AUTO_PROVISION=true
AZURE_SSO_DEFAULT_ROLE=viewer
# Optional Google Workspace sign-in. Separate from the Google Drive connector.
# Create an OAuth Web client and register PUBLIC_URL as an authorized JS origin.
GOOGLE_SSO_CLIENT_ID=
GOOGLE_SSO_ALLOWED_DOMAINS=
GOOGLE_SSO_AUTO_PROVISION=false
GOOGLE_SSO_DEFAULT_ROLE=viewer
# Only needed for a separately hosted Word pane; bundled /word-addin needs none.
ADDIN_ALLOWED_ORIGINS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=false

# Document connectors. Each OAuth app must allow PUBLIC_URL followed by
# /api/v1/connectors/{provider}/callback (see docs/connectors.md).
# Google/Microsoft/Box/Dropbox credentials can also be saved in Settings > Sources.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public, origin-restricted Picker key; separate from the private Gemini key above.
GOOGLE_PICKER_API_KEY=
GOOGLE_APP_ID=
GOOGLE_REDIRECT_URI=
MICROSOFT_CLIENT_SECRET=
# Separate callback from Microsoft SSO's MICROSOFT_REDIRECT_URI.
MICROSOFT_CONNECTOR_REDIRECT_URI=
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_REDIRECT_URI=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REDIRECT_URI=
CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=
CLIO_BASE_URL=https://app.clio.com
CLIO_REDIRECT_URI=
FILEVINE_ENABLED=false
FILEVINE_API_KEY=
FILEVINE_API_SECRET=
FILEVINE_BASE_URL=https://api.filevine.io
# These two adapters retain the original explicit opt-in pending live-tenant QA.
EXPERIMENTAL_CONNECTORS=false
NETDOCUMENTS_CLIENT_ID=
NETDOCUMENTS_CLIENT_SECRET=
NETDOCUMENTS_VAULT_HOST=https://vault.netvoyage.com
NETDOCUMENTS_API_HOST=https://api.vault.netvoyage.com
NETDOCUMENTS_REDIRECT_URI=
IMANAGE_CLIENT_ID=
IMANAGE_CLIENT_SECRET=
IMANAGE_BASE_URL=https://cloudimanage.com
IMANAGE_REDIRECT_URI=

# Optional: reuse an embedder instead of creating one with setup-goodmem.
# Setup provisions a scoped controller and this many active reader identities.
GOODMEM_IDENTITY_CAPACITY=64
# Additional embedding model UUIDs authorized during offline setup (comma-separated).
GOODMEM_ALLOWED_EMBEDDER_IDS=
GOODMEM_EMBEDDER_ID=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
GOODMEM_RERANKER_ID=
# GoodMem's on-premise dots.ocr endpoint, reachable from the GoodMem container.
# The default points to a model on the Docker host; no hosted OCR fallback is used.
GOODMEM_OCR_BASE_URL=http://host.docker.internal:8001/v1
# Tested GoodMem server v1.0.334
GOODMEM_IMAGE=ghcr.io/pair-systems-inc/goodmem/server@sha256:162b02ebefae8c84db2e00856ead6c7d6e465d5afb8e6d68d5cc8e063b61a53b

# For a standalone binary using an EXISTING GoodMem installation:
# DATABASE_URL=postgres://casecite:password@localhost:5432/casecite?sslmode=require
# GOODMEM_BASE_URL=http://localhost:8080
# GOODMEM_CONFIG_FILE=/secure/runtime/goodmem.json
# Administrative commands ONLY; never export/mount these in the application:
# GOODMEM_API_KEY=your-administrative-key
# GOODMEM_PROVISIONING_FILE=/secure/provisioning/admin.json
# Run setup-goodmem first; see docs/goodmem-security.md for upgrades.
