      {
        "name": "memo",
        "kind": "draft_document",
        "params": {
          "instructions": "Draft a due-diligence findings memo. Summarise the extracted terms by contract, set out the change-of-control and assignment exposure the research found with its sources, and list the consents and notices the transaction will need. Research answer: {{research.data.answer}}",
          "include_outputs_from": [
            "extract",
