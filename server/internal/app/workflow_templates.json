[
  {
    "key": "nda_intake",
    "name": "NDA intake",
    "description": "Extract the key terms of every incoming NDA, run the full contract review on each, and check any authorities the review cites.",
    "steps": [
      {
        "name": "extract",
        "kind": "extract_fields",
        "params": {
          "fields": [
            {
              "key": "counterparty",
              "name": "Counterparty",
              "description": "The other party to the agreement",
              "type": "text"
            },
            {
              "key": "effective_date",
              "name": "Effective date",
              "description": "When the agreement takes effect",
              "type": "date"
            },
            {
              "key": "term",
              "name": "Term",
              "description": "How long confidentiality obligations last",
              "type": "duration"
            },
            {
              "key": "mutual",
              "name": "Mutual",
              "description": "Do both parties disclose and receive?",
              "type": "boolean"
            },
            {
              "key": "governing_law",
              "name": "Governing law",
              "description": "State or country whose law governs",
              "type": "text"
            },
            {
              "key": "residuals_clause",
              "name": "Residuals clause",
              "description": "May the recipient use information retained in unaided memory?",
              "type": "boolean"
            }
          ],
          "table_name": null
        },
        "inputs": {
          "source": "run",
          "document_ids": [],
          "step": null
        },
        "condition": null
      },
      {
        "name": "review",
        "kind": "analyze_contract",
        "params": {
          "contract_type": "nda",
          "jurisdiction": null,
          "representing": null,
          "posture": "balanced",
          "instructions": null
        },
        "inputs": {
          "source": "run",
          "document_ids": [],
          "step": null
        },
        "condition": null
      },
      {
        "name": "citations",
        "kind": "citation_check",
        "params": {
          "citations": [],
          "from_steps": [
            "review"
          ]
        },
        "inputs": {
          "source": "run",
          "document_ids": [],
          "step": null
        },
        "condition": null
      }
    ]
  },
  {
    "key": "lease_review",
    "name": "Lease review",
    "description": "Extract the commercial terms of each lease, compare every lease clause by clause against the first one as the baseline, and draft a summary of the differences.",
    "steps": [
      {
        "name": "extract",
        "kind": "extract_fields",
        "params": {
          "fields": [
            {
              "key": "landlord",
              "name": "Landlord",
              "description": "",
              "type": "text"
            },
            {
              "key": "tenant",
              "name": "Tenant",
              "description": "",
              "type": "text"
            },
            {
              "key": "premises",
              "name": "Premises",
              "description": "Address or description of the space",
              "type": "text"
            },
            {
              "key": "commencement_date",
              "name": "Commencement date",
              "description": "",
              "type": "date"
            },
            {
              "key": "term",
              "name": "Term",
              "description": "",
              "type": "duration"
            },
            {
              "key": "base_rent",
              "name": "Base rent",
              "description": "Monthly or annual base rent",
              "type": "money"
            },
            {
              "key": "renewal_option",
              "name": "Renewal option",
              "description": "Does the tenant have an option to renew?",
              "type": "boolean"
            },
            {
              "key": "assignment",
              "name": "Assignment",
              "description": "May the tenant assign or sublet without consent?",
              "type": "boolean"
            }
          ],
          "table_name": null
        },
        "inputs": {
          "source": "run",
          "document_ids": [],
          "step": null
        },
        "condition": null
      },
      {
        "name": "compare",
        "kind": "compare_contracts",
        "params": {
          "baseline": "first_input",
          "baseline_document_id": null,
          "focus": "rent, term, renewal, assignment and repair obligations"
        },
        "inputs": {
          "source": "run",
          "document_ids": [],
          "step": null
        },
        "condition": null
      },
      {
        "name": "summary",
        "kind": "draft_document",
        "params": {
          "instructions": "Write a lease comparison memo for the supervising attorney. Open with a table of the extracted terms, then summarise the material differences the comparison found, clause by clause, and close with the points that need negotiation. Extracted terms: {{extract.data.values}}",
          "include_outputs_from": [
            "compare"
          ],
          "reference_document_ids": []
        },
        "inputs": {
          "source": "run",
          "document_ids": [],
          "step": null
        },
        "condition": null
      }
    ]
  },
  {
