        "inputs": {
          "source": "run",
          "document_ids": [],
          "step": null
        },
        "condition": null
      },
      {
        "name": "research",
        "kind": "deep_research",
        "params": {
          "question": "Across these contracts, which agreements need counterparty consent on a change of control or assignment, and how have courts treated anti-assignment and change-of-control clauses in a sale of the business? Extracted terms: {{extract.data.values}}",
          "tools": null
        },
        "inputs": {
          "source": "run",
          "document_ids": [],
          "step": null
        },
        "condition": null
