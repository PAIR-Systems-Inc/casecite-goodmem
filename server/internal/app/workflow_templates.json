    "steps": [
      {
        "name": "extract",
        "kind": "extract_fields",
        "params": {
          "fields": [
            {
              "key": "counterparty",
              "name": "Counterparty",
              "description": "",
              "type": "text"
            },
            {
              "key": "contract_type",
              "name": "Contract type",
              "description": "e.g. MSA, SaaS, supply, employment",
