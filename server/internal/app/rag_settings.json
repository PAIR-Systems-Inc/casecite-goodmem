{
  "vector_db": {
    "default": "goodmem",
    "pattern": "^goodmem$"
  },
  "index_name": {
    "default": "casecite-legal-docs",
    "min_length": 1,
    "max_length": 100
  },
  "embedding_model": {
    "default": "text-embedding-3-small",
    "max_length": 100
  },
  "document_embedder_id": {
    "default": "",
